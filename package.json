{
  "name": "bbe-elearning",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:business-rules": "ts-node -P tsconfig.test.json src/test/business-rules.test.ts",
    "test:video-guard": "ts-node -P tsconfig.test.json src/test/video-playback-guard.test.ts",
    "test:video-controls": "ts-node -P tsconfig.test.json src/test/video-fullscreen-controls.test.ts",
    "test:video-youtube-ux": "ts-node -P tsconfig.test.json src/test/video-controls-youtube-ux.test.ts",
    "test:video-switching-leak": "ts-node -P tsconfig.test.json src/test/video-switching-leak.test.ts",
    "test:baseline-safety": "node --test scripts/baseline-empty-database.test.mjs",
    "test:leaderboard-integration": "node scripts/test-chapter-leaderboard-integration.mjs",
    "test:learning-flow-integration": "node scripts/test-learning-flow-integration.mjs",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:baseline-empty": "node scripts/baseline-empty-database.mjs",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "ts-node -P prisma/tsconfig.seed.json prisma/seed.ts",
    "db:seed-demo": "ts-node -P prisma/tsconfig.seed.json scripts/seed-demo-safe.ts",
    "db:fix-durations": "ts-node -P scripts/tsconfig.json scripts/fix-video-durations.ts",
    "db:reset": "prisma migrate reset --force",
    "db:generate": "prisma generate",
    "db:audit-strict-video": "ts-node -P scripts/tsconfig.json scripts/audit-strict-video-migration.ts",
    "db:audit-final-exam-versions": "node scripts/audit-final-exam-versions.mjs",
    "test:learning-cycles": "ts-node -P tsconfig.test.json src/test/learning-cycles.test.ts",
    "test:learning-cycles-integration": "node scripts/test-learning-cycles-integration.cjs",
    "learning:scheduler": "node scripts/learning-scheduler.mjs",
    "db:seed-rich": "ts-node -P scripts/tsconfig.json --transpile-only scripts/seed-rich-demo.ts --apply",
    "db:seed-rich-progress": "ts-node -P scripts/tsconfig.json --transpile-only scripts/seed-rich-progress.ts --apply",
    "db:snapshot-demo": "ts-node -P scripts/tsconfig.json --transpile-only scripts/snapshot-demo-periods.ts --apply",
    "test:learning-security": "node scripts/test-learning-security.mjs",
    "test:reward-pause-integration": "node scripts/test-reward-pause-integration.cjs",
    "db:audit-learning-mapping": "node scripts/audit-learning-mapping.mjs",
    "test:migration-rehearsal": "node scripts/rehearse-learning-migration.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@aws-sdk/s3-request-presigner": "^3.1123.0",
    "@prisma/client": "6.19.3",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "next": "^14.2.35",
    "pg": "^8.23.0",
    "prisma": "6.19.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.25.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "ts-node -P prisma/tsconfig.seed.json prisma/seed.ts"
  }
}
