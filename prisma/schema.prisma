generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  CHAPTER_LEADER
  MEMBER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED

  @@map("user_status")
}

enum ChapterStatus {
  ACTIVE
  INACTIVE

  @@map("chapter_status")
}

enum MembershipStatus {
  ACTIVE
  LEFT

  @@map("membership_status")
}

enum InvitationRole {
  CHAPTER_LEADER
  DNA_LEAD
  MEMBER

  @@map("invitation_role")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED

  @@map("invitation_status")
}

enum CourseStatus {
  DRAFT
  PUBLISHED

  @@map("course_status")
}

enum CourseVisibility {
  PUBLIC
  PRIVATE

  @@map("course_visibility")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE

  @@map("question_type")
}

enum AssessmentType {
  LESSON
  COURSE_FINAL

  @@map("assessment_type")
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  CANCELLED

  @@map("attempt_status")
}

enum VideoProvider {
  YOUTUBE

  @@map("video_provider")
}

enum OrganizationUnitType {
  ROOT
  DNA
  DNA_GROUP
  CHAPTER
  DEPARTMENT

  @@map("organization_unit_type")
}

enum OrganizationMembershipStatus {
  ACTIVE
  ENDED

  @@map("organization_membership_status")
}

enum PositionScope {
  PLATFORM
  DNA
  CHAPTER
  DEPARTMENT

  @@map("position_scope")
}

enum LearningAssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
  WAIVED
  ENDED

  @@map("learning_assignment_status")
}

enum RestrictionType {
  DIRECT_ADMIN
  DEADLINE
  CHAPTER_CASCADE

  @@map("restriction_type")
}

enum KpiStatus {
  BLACK
  RED
  YELLOW
  GREEN

  @@map("kpi_status")
}

enum ChapterReorganizationStatus {
  DRAFT
  SCHEDULED
  APPLIED
  CANCELLED

  @@map("chapter_reorganization_status")
}

enum StarReason {
  VIDEO_COMPLETION
  MODULE_QUIZ_PASS
  MODULE_QUIZ_BONUS
  COURSE_FINAL_PASS
  COURSE_FINAL_BONUS
  ADMIN_ADJUSTMENT

  @@map("star_reason")
}

// ============================================================
// MODELS
// ============================================================

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique @db.VarChar(255)
  display_name     String?    @db.VarChar(120)
  password_hash    String     @db.VarChar(255)
  role             UserRole
  status           UserStatus @default(ACTIVE)
  failed_login_count Int     @default(0)
  locked_until     DateTime?  @db.Timestamp
  created_at       DateTime   @default(now()) @db.Timestamp
  updated_at       DateTime   @updatedAt @db.Timestamp
  auth_version     Int        @default(1)

  deactivated_by_user_id String?   @db.Uuid
  deactivated_by_role    String?   @db.VarChar(50)
  deactivated_at         DateTime? @db.Timestamp
  deactivated_reason     String?   @db.Text
  cascade_lead_id        String?   @db.Uuid
  lock_reason            String?   @db.VarChar(50)

  chapter_members  ChapterMember[]
  invitations      Invitation[] @relation("InvitedBy")
  courses          Course[]
  lessonProgress   LessonProgress[]
  attempts         Attempt[]
  audit_logs       AuditLog[]
  password_reset_tokens PasswordResetToken[]
  created_assessments   Assessment[]
  refresh_tokens        RefreshToken[]
  comments              LessonComment[]
  organization_memberships OrganizationMembership[]
  position_assignments   PositionAssignment[]
  learning_assignments   UserLearningAssignment[]
  stars                  StarLedger[]
  restrictions           AccessRestriction[] @relation("RestrictedUser")
  restrictions_created   AccessRestriction[] @relation("RestrictionCreatedBy")
  restrictions_lifted    AccessRestriction[] @relation("RestrictionLiftedBy")
  kpi_configurations     ChapterMonthlyKpi[] @relation("KpiConfiguredBy")

  @@map("users")
  @@index([email])
  @@index([status])
  @@index([role])
  @@index([cascade_lead_id])
  @@index([deactivated_by_user_id])
}

model Chapter {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique @db.VarChar(255)
  description String?    @db.Text
  status      ChapterStatus @default(ACTIVE)
  created_at  DateTime   @default(now()) @db.Timestamp
  updated_at  DateTime   @updatedAt @db.Timestamp
  organization_unit_id String? @unique @db.Uuid
  current_term_number  Int?

  chapter_members ChapterMember[]
  invitations     Invitation[]
  organization_unit OrganizationUnit? @relation(fields: [organization_unit_id], references: [id], onDelete: SetNull)
  monthly_kpis ChapterMonthlyKpi[]

  @@map("chapters")
  @@index([status])
}

model ChapterMember {
  id         String    @id @default(uuid()) @db.Uuid
  chapter_id String    @db.Uuid
  user_id    String    @db.Uuid
  joined_at  DateTime  @default(now()) @db.Timestamp

  chapter    Chapter   @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("chapter_members")
  @@unique([chapter_id, user_id])
  @@unique([user_id])
  @@index([chapter_id, user_id])
}

model Invitation {
  id            String            @id @default(uuid()) @db.Uuid
  email         String            @db.VarChar(255)
  display_name  String?           @db.VarChar(120)
  chapter_name  String?           @db.VarChar(255)
  chapter_description String?      @db.Text
  role          InvitationRole
  chapter_id    String?           @db.Uuid
  organization_unit_id String?     @db.Uuid
  invited_by    String            @db.Uuid
  token_hash    String            @unique @db.VarChar(255)
  status        InvitationStatus  @default(PENDING)
  expires_at    DateTime          @db.Timestamp
  accepted_at   DateTime?         @db.Timestamp
  cancelled_at  DateTime?         @db.Timestamp
  created_at    DateTime          @default(now()) @db.Timestamp

  chapter       Chapter?          @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  organization_unit OrganizationUnit? @relation(fields: [organization_unit_id], references: [id], onDelete: Cascade)
  invited_by_user User            @relation(fields: [invited_by], references: [id], name: "InvitedBy", onDelete: Cascade)

  @@map("invitations")
  @@index([email])
  @@index([status])
  @@index([expires_at])
  @@index([email, status])
  @@index([organization_unit_id, status])
}

model Course {
  id            String             @id @default(uuid()) @db.Uuid
  title         String             @db.VarChar(255)
  description   String?            @db.Text
  status        CourseStatus       @default(DRAFT)
  visibility    CourseVisibility   @default(PRIVATE)
  created_by    String             @db.Uuid
  published_at  DateTime?          @db.Timestamp
  created_at    DateTime           @default(now()) @db.Timestamp
  updated_at    DateTime           @updatedAt @db.Timestamp
  cover_url     String?            @db.VarChar(1000)
  cover_public_id String?          @db.VarChar(500)
  mandatory_default_due_days Int   @default(30)

  created_by_user User             @relation(fields: [created_by], references: [id], onDelete: Cascade)
  sessions      Session[]
  final_assessment Assessment? @relation("CourseFinalAssessment")
  learning_rules LearningRule[]
  learning_assignments UserLearningAssignment[]

  @@map("courses")
  @@index([status, visibility])
  @@index([created_by])
}

model Session {
  id          String     @id @default(uuid()) @db.Uuid
  course_id   String     @db.Uuid
  title       String     @db.VarChar(255)
  description String?    @db.Text
  sort_order  Int
  created_at  DateTime   @default(now()) @db.Timestamp
  updated_at  DateTime   @updatedAt @db.Timestamp

  course      Course     @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons     Lesson[]

  @@map("sessions")
  @@index([course_id, sort_order])
}

model Lesson {
  id          String     @id @default(uuid()) @db.Uuid
  session_id  String     @db.Uuid
  title       String     @db.VarChar(255)
  description String?    @db.Text
  sort_order  Int
  created_at  DateTime   @default(now()) @db.Timestamp
  updated_at  DateTime   @updatedAt @db.Timestamp

  session     Session    @relation(fields: [session_id], references: [id], onDelete: Cascade)
  video       Video?
  documents   Document[]
  progress    LessonProgress[]
  comments    LessonComment[]
  assessment  Assessment?

  @@map("lessons")
  @@index([session_id, sort_order])
}

model Video {
  id                String         @id @default(uuid()) @db.Uuid
  lesson_id         String         @unique @db.Uuid
  provider          VideoProvider  @default(YOUTUBE)
  youtube_video_id  String         @db.VarChar(255)
  duration_seconds  Int
  title             String?        @db.VarChar(255)
  created_at        DateTime       @default(now()) @db.Timestamp
  updated_at        DateTime       @updatedAt @db.Timestamp

  lesson            Lesson         @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@map("videos")
  @@index([provider, youtube_video_id])
}

model Document {
  id         String    @id @default(uuid()) @db.Uuid
  lesson_id  String    @db.Uuid
  file_name  String    @db.VarChar(255)
  storage_key String   @db.VarChar(500)
  mime_type  String    @db.VarChar(100)
  file_size  BigInt
  created_at DateTime  @default(now()) @db.Timestamp
  updated_at DateTime  @updatedAt @db.Timestamp

  lesson     Lesson    @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@map("documents")
  @@index([lesson_id])
}

model LessonProgress {
  id                          String    @id @default(uuid()) @db.Uuid
  user_id                     String    @db.Uuid
  lesson_id                   String    @db.Uuid
  completed                   Boolean   @default(false)
  completed_at                DateTime? @db.Timestamp
  last_position_seconds       Int?
  furthest_watched_position_seconds Int?
  last_watched_at             DateTime? @db.Timestamp
  created_at                  DateTime  @default(now()) @db.Timestamp
  updated_at                  DateTime  @updatedAt @db.Timestamp

  user                        User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson                      Lesson    @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@map("lesson_progress")
  @@unique([user_id, lesson_id])
  @@index([user_id, lesson_id])
  @@index([user_id, completed, lesson_id])
  @@index([user_id])
  @@index([lesson_id])
}

model Assessment {
  id            String     @id @default(uuid()) @db.Uuid
  type          AssessmentType @default(LESSON)
  lesson_id     String?    @unique @db.Uuid
  course_id     String?    @unique @db.Uuid
  title         String     @db.VarChar(255)
  description   String?    @db.Text
  question_count Int       @default(10)
  duration_minutes Int     @default(30)
  created_by    String     @db.Uuid
  created_at    DateTime   @default(now()) @db.Timestamp
  updated_at    DateTime   @updatedAt @db.Timestamp

  lesson        Lesson?    @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  course        Course?    @relation("CourseFinalAssessment", fields: [course_id], references: [id], onDelete: Cascade)
  created_by_user User    @relation(fields: [created_by], references: [id], onDelete: Cascade)
  questions     Question[]
  attempts      Attempt[]
  question_pools QuestionPool[]
  final_exam_versions FinalExamVersion[]

  @@map("assessments")
}

model FinalExamVersion {
  id               String     @id @default(uuid()) @db.Uuid
  assessment_id    String     @db.Uuid
  version_number   Int
  is_active        Boolean    @default(false)
  question_count   Int
  duration_minutes Int
  title            String     @db.VarChar(255)
  description      String?    @db.Text
  created_at       DateTime   @default(now()) @db.Timestamp

  assessment       Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  questions        Question[]
  attempts         Attempt[]

  @@unique([assessment_id, version_number])
  @@index([assessment_id, is_active])
  @@map("final_exam_versions")
}

model Question {
  id              String         @id @default(uuid()) @db.Uuid
  assessment_id   String         @db.Uuid
  question_text   String         @db.Text
  question_type   QuestionType   @default(SINGLE_CHOICE)
  points          Int            @default(1)
  sort_order      Int
  explanation     String?        @db.Text
  created_at      DateTime       @default(now()) @db.Timestamp
  updated_at      DateTime       @updatedAt @db.Timestamp
  pool_id         String?        @db.Uuid
  final_exam_version_id String?  @db.Uuid
  source_assessment_id String?   @db.Uuid

  assessment      Assessment     @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  options         QuestionOption[]
  attempt_questions AttemptQuestion[]
  attempt_answers  AttemptAnswer[]
  pool             QuestionPool? @relation(fields: [pool_id], references: [id], onDelete: SetNull)
  final_exam_version FinalExamVersion? @relation(fields: [final_exam_version_id], references: [id], onDelete: Cascade)

  @@map("questions")
  @@index([assessment_id, sort_order])
  @@index([pool_id])
  @@index([final_exam_version_id])
}

model QuestionOption {
  id            String     @id @default(uuid()) @db.Uuid
  question_id   String     @db.Uuid
  option_text   String     @db.Text
  is_correct    Boolean    @default(false)
  sort_order    Int

  question      Question   @relation(fields: [question_id], references: [id], onDelete: Cascade)
  attempt_answers AttemptAnswer[]

  @@map("question_options")
  @@index([question_id, sort_order])
  @@index([question_id])
}

model Attempt {
  id                String           @id @default(uuid()) @db.Uuid
  assessment_id     String           @db.Uuid
  final_exam_version_id String?      @db.Uuid
  user_id           String           @db.Uuid
  attempt_number    Int
  status            AttemptStatus    @default(IN_PROGRESS)
  started_at        DateTime         @db.Timestamp
  expires_at        DateTime         @db.Timestamp
  submitted_at      DateTime?        @db.Timestamp
  score             Decimal?         @db.Decimal(5, 2)
  passed            Boolean?
  created_at        DateTime         @default(now()) @db.Timestamp

  assessment        Assessment       @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  final_exam_version FinalExamVersion? @relation(fields: [final_exam_version_id], references: [id], onDelete: Restrict)
  user              User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  attempt_questions AttemptQuestion[]
  attempt_answers   AttemptAnswer[]

  @@map("attempts")
  @@index([user_id, assessment_id])
  @@index([user_id, status, assessment_id, submitted_at])
  @@index([assessment_id, user_id, created_at])
  @@index([final_exam_version_id])
  @@index([status])
}

model AttemptQuestion {
  id             String    @id @default(uuid()) @db.Uuid
  attempt_id     String    @db.Uuid
  question_id    String    @db.Uuid
  display_order  Int

  attempt        Attempt   @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question       Question  @relation(fields: [question_id], references: [id], onDelete: Cascade)

  @@map("attempt_questions")
  @@unique([attempt_id, question_id])
  @@index([attempt_id, display_order])
  @@index([attempt_id, question_id])
}

model AttemptAnswer {
  id                String     @id @default(uuid()) @db.Uuid
  attempt_id        String     @db.Uuid
  question_id       String     @db.Uuid
  selected_option_id String?   @db.Uuid
  answered_at       DateTime?  @db.Timestamp
  is_correct        Boolean?

  attempt           Attempt    @relation(fields: [attempt_id], references: [id], onDelete: Cascade)
  question          Question   @relation(fields: [question_id], references: [id], onDelete: Cascade)
  selected_option   QuestionOption? @relation(fields: [selected_option_id], references: [id], onDelete: SetNull)

  @@map("attempt_answers")
  @@unique([attempt_id, question_id])
  @@index([attempt_id, question_id])
  @@index([attempt_id])
  @@index([question_id])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  user_id    String    @db.Uuid
  token_hash String    @unique @db.VarChar(255)
  expires_at DateTime  @db.Timestamp
  used_at    DateTime? @db.Timestamp
  created_at DateTime  @default(now()) @db.Timestamp

  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([user_id])
  @@index([expires_at])
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actor_user_id String?  @db.Uuid
  action       String    @db.VarChar(100)
  entity_type  String    @db.VarChar(100)
  entity_id    String    @db.Uuid
  metadata     Json?
  created_at   DateTime  @default(now()) @db.Timestamp

  actor        User?     @relation(fields: [actor_user_id], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([actor_user_id])
  @@index([entity_type, entity_id])
  @@index([action])
  @@index([created_at])
}

model RefreshToken {
  id            String    @id @default(uuid()) @db.Uuid
  user_id       String    @db.Uuid
  token_hash    String    @unique @db.VarChar(255)
  expires_at    DateTime  @db.Timestamp
  revoked_at    DateTime? @db.Timestamp
  created_at    DateTime  @default(now()) @db.Timestamp

  user          User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
  @@index([user_id])
  @@index([expires_at])
  @@index([revoked_at])
}

model LessonComment {
  id         String    @id @default(uuid()) @db.Uuid
  lesson_id  String    @db.Uuid
  user_id    String    @db.Uuid
  parent_id  String?   @db.Uuid
  content    String    @db.Text
  created_at DateTime  @default(now()) @db.Timestamp
  updated_at DateTime  @updatedAt @db.Timestamp

  lesson     Lesson    @relation(fields: [lesson_id], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  parent     LessonComment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies    LessonComment[] @relation("CommentReplies")

  @@map("lesson_comments")
  @@index([lesson_id, created_at])
  @@index([parent_id])
}

// ---------------------------------------------------------------------------
// Organization, learning entitlement, reward and ranking foundation.
// These models are append-only so the current ChapterMember/User history stays
// available while the application moves to assignment-based authorization.
// ---------------------------------------------------------------------------

model OrganizationUnit {
  id          String               @id @default(uuid()) @db.Uuid
  name        String               @db.VarChar(255)
  type        OrganizationUnitType
  parent_id   String?              @db.Uuid
  status      ChapterStatus        @default(ACTIVE)
  created_at  DateTime             @default(now()) @db.Timestamp
  updated_at  DateTime             @updatedAt @db.Timestamp

  parent      OrganizationUnit?    @relation("OrganizationTree", fields: [parent_id], references: [id], onDelete: Restrict)
  children    OrganizationUnit[]   @relation("OrganizationTree")
  chapter     Chapter?
  memberships OrganizationMembership[]
  positions   PositionAssignment[]
  learning_rules LearningRule[]
  restrictions AccessRestriction[] @relation("RestrictedOrganizationUnit")
  invitations Invitation[]

  @@unique([parent_id, name])
  @@index([type, status])
  @@index([parent_id])
  @@map("organization_units")
}

model OrganizationMembership {
  id          String                       @id @default(uuid()) @db.Uuid
  user_id     String                       @db.Uuid
  unit_id     String                       @db.Uuid
  status      OrganizationMembershipStatus @default(ACTIVE)
  starts_at   DateTime                     @default(now()) @db.Timestamp
  ends_at     DateTime?                    @db.Timestamp
  created_at  DateTime                     @default(now()) @db.Timestamp

  user        User                         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  unit        OrganizationUnit             @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  @@index([user_id, status])
  @@index([user_id, status, starts_at, ends_at])
  @@index([unit_id, status])
  @@index([unit_id, status, starts_at, ends_at])
  @@map("organization_memberships")
}

model Position {
  id          String        @id @default(uuid()) @db.Uuid
  code        String        @unique @db.VarChar(100)
  name        String        @db.VarChar(255)
  scope       PositionScope
  is_manager  Boolean       @default(false)
  created_at  DateTime      @default(now()) @db.Timestamp

  assignments PositionAssignment[]
  permissions PositionPermission[]
  learning_rules LearningRule[]

  @@map("positions")
}

model Permission {
  id          String       @id @default(uuid()) @db.Uuid
  code        String       @unique @db.VarChar(120)
  description String?      @db.Text
  created_at  DateTime     @default(now()) @db.Timestamp

  positions   PositionPermission[]

  @@map("permissions")
}

model PositionPermission {
  position_id   String     @db.Uuid
  permission_id String     @db.Uuid

  position      Position   @relation(fields: [position_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([position_id, permission_id])
  @@map("position_permissions")
}

model PositionAssignment {
  id          String           @id @default(uuid()) @db.Uuid
  user_id     String           @db.Uuid
  position_id String           @db.Uuid
  unit_id     String           @db.Uuid
  is_primary  Boolean          @default(false)
  starts_at   DateTime         @default(now()) @db.Timestamp
  ends_at     DateTime?        @db.Timestamp
  appointed_by String?         @db.Uuid
  created_at  DateTime         @default(now()) @db.Timestamp

  user        User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  position    Position         @relation(fields: [position_id], references: [id], onDelete: Restrict)
  unit        OrganizationUnit @relation(fields: [unit_id], references: [id], onDelete: Restrict)

  @@index([user_id, starts_at, ends_at])
  @@index([unit_id, position_id, starts_at, ends_at])
  @@map("position_assignments")
}

model LearningRule {
  id                String            @id @default(uuid()) @db.Uuid
  course_id         String            @db.Uuid
  organization_unit_id String?        @db.Uuid
  position_id       String?           @db.Uuid
  mandatory         Boolean           @default(true)
  can_view          Boolean           @default(true)
  can_assess        Boolean           @default(true)
  can_earn_stars    Boolean           @default(true)
    due_days          Int?
  effective_from    DateTime          @default(now()) @db.Timestamp
  effective_until   DateTime?         @db.Timestamp
  created_at        DateTime          @default(now()) @db.Timestamp

  course            Course            @relation(fields: [course_id], references: [id], onDelete: Cascade)
  organization_unit OrganizationUnit? @relation(fields: [organization_unit_id], references: [id], onDelete: Cascade)
  position          Position?         @relation(fields: [position_id], references: [id], onDelete: Cascade)
  assignments       UserLearningAssignment[]

  @@index([course_id, effective_from, effective_until])
  @@index([organization_unit_id, position_id])
  @@index([course_id, organization_unit_id, position_id, effective_until])
  @@map("learning_rules")
}

model UserLearningAssignment {
  id                String                   @id @default(uuid()) @db.Uuid
  user_id           String                   @db.Uuid
  course_id         String                   @db.Uuid
  rule_id           String?                  @db.Uuid
  mandatory         Boolean                  @default(true)
  can_view          Boolean                  @default(true)
  can_assess        Boolean                  @default(true)
  can_earn_stars    Boolean                  @default(true)
  due_at            DateTime?                @db.Timestamp
  status            LearningAssignmentStatus @default(ASSIGNED)
  assigned_at       DateTime                 @default(now()) @db.Timestamp
  ended_at          DateTime?                @db.Timestamp
  completed_at      DateTime?                @db.Timestamp

  user              User                     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course            Course                   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  rule              LearningRule?            @relation(fields: [rule_id], references: [id], onDelete: SetNull)

  @@index([user_id, status, due_at])
  @@index([course_id, status])
  @@index([rule_id])
  @@index([rule_id, status])
  @@map("user_learning_assignments")
}

model AccessRestriction {
  id                 String            @id @default(uuid()) @db.Uuid
  user_id            String?           @db.Uuid
  organization_unit_id String?         @db.Uuid
  type               RestrictionType
  reason             String            @db.Text
  source_reference   String?           @db.VarChar(255)
  created_by_user_id String?           @db.Uuid
  lifted_by_user_id  String?           @db.Uuid
  created_at         DateTime          @default(now()) @db.Timestamp
  lifted_at          DateTime?         @db.Timestamp

  user               User?             @relation("RestrictedUser", fields: [user_id], references: [id], onDelete: Cascade)
  organization_unit  OrganizationUnit? @relation("RestrictedOrganizationUnit", fields: [organization_unit_id], references: [id], onDelete: Cascade)
  created_by          User?             @relation("RestrictionCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  lifted_by           User?             @relation("RestrictionLiftedBy", fields: [lifted_by_user_id], references: [id], onDelete: SetNull)

  @@index([user_id, lifted_at])
  @@index([organization_unit_id, lifted_at])
  @@index([type, created_at])
  @@map("access_restrictions")
}

model StarLedger {
  id          String     @id @default(uuid()) @db.Uuid
  user_id     String     @db.Uuid
  amount      Int
  reason      StarReason
  reward_key  String     @unique @db.VarChar(255)
  source_type String     @db.VarChar(100)
  source_id   String     @db.Uuid
  metadata    Json?
  awarded_at  DateTime   @default(now()) @db.Timestamp

  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, awarded_at])
  @@index([source_type, source_id])
  @@map("star_ledger")
}

model QuestionPool {
  id            String     @id @default(uuid()) @db.Uuid
  assessment_id String     @db.Uuid
  name          String     @db.VarChar(255)
  sort_order    Int
  draw_count    Int        @default(3)
  created_at    DateTime   @default(now()) @db.Timestamp

  assessment    Assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade)
  questions     Question[]

  @@unique([assessment_id, sort_order])
  @@index([assessment_id])
  @@map("question_pools")
}

model ChapterMonthlyKpi {
  id                  String    @id @default(uuid()) @db.Uuid
  chapter_id          String    @db.Uuid
  month_start         DateTime  @db.Date
  status              KpiStatus
  configured_by_user_id String  @db.Uuid
  note                String?   @db.Text
  created_at          DateTime  @default(now()) @db.Timestamp
  updated_at          DateTime  @updatedAt @db.Timestamp

  chapter             Chapter   @relation(fields: [chapter_id], references: [id], onDelete: Cascade)
  configured_by       User      @relation("KpiConfiguredBy", fields: [configured_by_user_id], references: [id], onDelete: Restrict)

  @@unique([chapter_id, month_start])
  @@index([month_start, status])
  @@map("chapter_monthly_kpis")
}

/** A confirmed future change of department/LT assignments inside one Chapter. */
model ChapterReorganization {
  id                String                      @id @default(uuid()) @db.Uuid
  chapter_id        String                      @db.Uuid
  effective_at      DateTime                    @db.Timestamp
  term_number       Int?
  status            ChapterReorganizationStatus @default(DRAFT)
  source_url        String?                     @db.Text
  created_by_user_id String                     @db.Uuid
  confirmed_at      DateTime?                   @db.Timestamp
  applied_at        DateTime?                   @db.Timestamp
  cancelled_at      DateTime?                   @db.Timestamp
  created_at        DateTime                    @default(now()) @db.Timestamp
  updated_at        DateTime                    @updatedAt @db.Timestamp

  items             ChapterReorganizationItem[]

  @@index([chapter_id, status, effective_at])
  @@map("chapter_reorganizations")
}

model ChapterReorganizationItem {
  id                    String                  @id @default(uuid()) @db.Uuid
  reorganization_id     String                  @db.Uuid
  user_id               String                  @db.Uuid
  display_name          String?                 @db.VarChar(120)
  department_unit_id    String                  @db.Uuid
  position_id           String?                 @db.Uuid
  is_primary            Boolean                 @default(true)
  validation_error      String?                 @db.Text
  created_at            DateTime                @default(now()) @db.Timestamp

  reorganization        ChapterReorganization   @relation(fields: [reorganization_id], references: [id], onDelete: Cascade)

  @@unique([reorganization_id, user_id])
  @@index([reorganization_id])
  @@map("chapter_reorganization_items")
}
